r\"><span class=\"decl_kind\">constructor</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Shenzhen/IOEffects.html#IOEffects.pure\"><span class=\"name\">IOEffects</span>.<span class=\"name\">pure</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">ξ</span> : <a href=\"./foundational_types.html\">Type</a> u}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">ι</span> : <a href=\"./foundational_types.html\">Type</a> v}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> x}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">a</span> : <span class=\"fn\">α</span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Shenzhen/IOEffects.html#IOEffects\">IOEffects</a> <span class=\"fn\">ξ</span> <span class=\"fn\">ι</span> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"Just return a value immediately, without doing any effects. ","docLink":"./Shenzhen/IOEffects.html#IOEffects.pure","kind":"ctor","line":9,"name":"IOEffects.pure","sourceLink":"https://github.com/a2435191/shenzhen-lean/blob/48728217f18fc01d439991efb2b77ce532d5d756/Shenzhen/IOEffects.lean#L9-L10"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">inductive</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Shenzhen/IOEffects.html#IOEffects\"><span class=\"name\">IOEffects</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">ξ</span> : <a href=\"./foundational_types.html\">Type</a> u)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">ι</span> : <a href=\"./foundational_types.html\">Type</a> v)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<