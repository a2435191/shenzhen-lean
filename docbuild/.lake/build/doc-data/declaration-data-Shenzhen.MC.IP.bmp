me\">IP</span>.<span class=\"name\">ofFin</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">m</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span>\n</span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\">m</span></span> → <span class=\"fn\"><a href=\"./Shenzhen/MC/IP.html#IP\">IP</a> <span class=\"fn\">m</span></span></span></div></div>","info":{"doc":"","docLink":"./Shenzhen/MC/IP.html#IP.ofFin","kind":"ctor","line":8,"name":"IP.ofFin","sourceLink":"https://github.com/a2435191/shenzhen-lean/blob/48728217f18fc01d439991efb2b77ce532d5d756/Shenzhen/MC/IP.lean#L8-L8"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Shenzhen/MC/IP.html#IP.none\"><span class=\"name\">IP</span>.<span class=\"name\">none</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Shenzhen/MC/IP.html#IP\">IP</a> <span class=\"fn\">0</span></span></div></div>","info":{"doc":"","docLink":"./Shenzhen/MC/IP.html#IP.none","kind":"ctor","line":7,"name":"IP.none","sourceLink":"https://github.com/a2435191/shenzhen-lean/blob/48728217f18fc01d439991efb2b77ce532d5d756/Shenzhen/MC/IP.lean#L7-L7"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">inductive</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Shenzhen/MC/IP.html#IP\"><span class=\"name\">IP</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Nat\">Nat</a> → <a href=\"./foundational_types.html\">Type</a></span></div></div>","info":{"doc":"`IP m` is the type of an instruction pointer for an `MC4000` with `m` instructions.\nChips can have zero instructions, so `IP m` is equivalent to `if m = 0 then Unit else Fin m`, but\nthis way we get `Repr` for free and nicer pattern-matching. ","docLink":"./Shenzhen/MC/IP.html#IP","kind":"inductive","line":3,"name":"IP","sourceLink":"https://github.com/a2435191/shenzhen-lean/blob/48728217f18fc01d439991efb2b77ce532d5d756/Shenzhen/MC/IP.lean#L3-L9"}}],"imports":["Init","Shenzhen.Instruction"],"instances":[{"className":"Repr","name":"instReprIP","typeNames":["IP"]},{"className":"ReprAtom","name":"IP.instReprAtomOfNatNat","typeNames":["IP"]},{"className":"Inhabited","name":"IP.instInhabited","typeNames":["IP"]},{"className":"Coe","name":"IP.instCoeFin","typeNames":["Fin","IP"]}],"name":"Shenzhen.MC.IP"}